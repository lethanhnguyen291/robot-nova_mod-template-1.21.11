{
    "java.compile.nullAnalysis.mode": "automatic",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx8G -Xms100m -Xlog:disable",
    
    // Tự động lưu an toàn khi chuyển cửa sổ (tránh lưu liên tục đè lên code của AI)
    "files.autoSave": "onFocusChange",
    
    // Khi file trên đĩa thay đổi (do AI sửa), nếu có xung đột VS Code sẽ hỏi thay vì tự ý ghi đè
    "files.saveConflictResolution": "askUser"
}